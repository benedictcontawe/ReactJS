# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase Admin SDK Configuration
# Get these values from Firebase Console → Project Settings → Service Accounts
# Click "Generate New Private Key" to download a JSON file, then extract these values:

# Your Firebase Project ID (from the JSON file: "project_id")
FIREBASE_PROJECT_ID=your-project-id

# Private Key from the service account JSON file (from "private_key" field)
# IMPORTANT: Keep the quotes and \n characters as shown
# The private key should be on multiple lines, use \n to represent newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n(multiple lines)\n-----END PRIVATE KEY-----\n"

# Client Email from the service account JSON file (from "client_email" field)
# Format: firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# Storage Bucket (from the JSON file or use: your-project-id.appspot.com)
# Optional: If not set, it will default to ${FIREBASE_PROJECT_ID}.appspot.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com